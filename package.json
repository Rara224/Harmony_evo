{
  "name": "harmony_evo",
  "version": "1.0.0",
  "description": "HarmonyOS DebugCase Library - scrape, structure, search, and inject bug fixes into evolver GEP",
  "main": "scripts/debug-case/schema.js",
  "scripts": {
    "test": "node scripts/test-seed.js",
    "test:functional": "node scripts/test-functional.js",
    "quality": "node scripts/debug-case/quality.js",
    "search": "node scripts/debug-case/search.js",
    "dashboard": "node scripts/debug-case/dashboard.js",
    "dashboard:html": "node scripts/debug-case/dashboard.js --html --output dashboard.html",
    "scrape": "node scripts/scrapers/huawei-forum.js",
    "dedupe:candidates": "node scripts/debug-case/dedupe-candidates.js",
    "extract": "node scripts/scrapers/llm-extractor.js",
    "promote": "node scripts/debug-case/promote.js",
    "inject": "node scripts/debug-case/inject.js",
    "status": "node scripts/debug-case/inject.js --status",
    "server": "node server/index.js"
  },
  "keywords": [
    "harmonyos",
    "debug",
    "gep",
    "evolver",
    "huawei",
    "bug-fix"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "playwright": "^1.60.0"
  }
}
