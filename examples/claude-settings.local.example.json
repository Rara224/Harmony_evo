{
  "env": {
    "HARMONY_EVO_SERVER": "http://SERVER_IP:3456",
    "HARMONY_EVO_UPLOAD_SIGNALS": "false"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/harmony-evo-client-standalone/bin/harmony-evo-client.js hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/harmony-evo-client-standalone/bin/harmony-evo-client.js hook user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/harmony-evo-client-standalone/bin/harmony-evo-client.js hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/harmony-evo-client-standalone/bin/harmony-evo-client.js hook post-tool-failure",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/harmony-evo-client-standalone/bin/harmony-evo-client.js hook stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
